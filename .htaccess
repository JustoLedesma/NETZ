ErrorDocument 404 /404.html
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forzar HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 1. Asegurar barra final en carpetas de países (/br -> /br/) para que LiteSpeed resuelva DirectoryIndex
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^([a-z]{2})$ $1/ [R=301,L]

    # 2. Si entran a /index o /br/index (con o sin .html), redirigir a la raíz limpia (/ o /br/)
    RewriteCond %{THE_REQUEST} \s/+(.*?/)?index(?:\.html)?[\s?] [NC]
    RewriteRule ^(.*)index(?:\.html)?$ /%1 [R=301,L]

    # 3. Si entran con .html explícito en cualquier otra página, redirigir a URL limpia (301)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 4. Servir index.html internamente para las carpetas de país (/br/ -> br/index.html)
    RewriteRule ^([a-z]{2})/$ $1/index.html [L]

    # 5. Reescribir URL limpia a archivo .html si existe (ej: /br/hosting-ilimitado -> br/hosting-ilimitado.html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # Fallback interno para LiteSpeed per-dir
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Caché de recursos estáticos compartidos (/assets/)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Assets inmutables: 1 año de caché
    <FilesMatch "\.(css|js|png|jpe?g|gif|ico|svg|woff2?|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    # Precios JSON: no-cache para reflejar cambios inmediatos
    <FilesMatch "\.json$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>
